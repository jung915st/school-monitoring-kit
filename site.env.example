# =====================================================================
# site.env — ALL per-school values for the school monitoring kit.
#   cp site.env.example site.env  &&  edit  &&  ./scripts/gen-secrets.sh  &&  ./scripts/render.sh
# Secrets are NOT kept here: gen-secrets.sh writes them to secrets.env (git-ignored, chmod 600).
# =====================================================================

# ---- Identity --------------------------------------------------------
SITE_CODE=lres                      # short school code, lowercase (used in names/tags)
SITE_NAME="LRES Elementary School"  # free text, shown in docs/alerts
TZ=Asia/Taipei

# ---- DNS names (internal service names; A records -> REVPROXY_IP) -------
DOMAIN=example.tc.edu.tw
NMS_HOST=nms.${DOMAIN}              # LibreNMS
GL_HOST=gl.${DOMAIN}                # Graylog
GFB_HOST=gfb.${DOMAIN}              # Grafana
SMOKE_HOST=sp.${DOMAIN}             # SmokePing
MESH_HOST=mesh.${DOMAIN}            # MeshCentral

# ---- Hosts (profile "standard" = 2 VMs; "lite" = set all three to the same IP) ----
PROFILE=standard                    # standard | lite
NMS_VM_IP=10.0.0.17                 # LibreNMS + SmokePing + MeshCentral host
LOG_VM_IP=10.0.0.13                 # Graylog + OpenSearch + Grafana (+ netmon) host
REVPROXY_IP=10.0.0.14               # nginx reverse proxy (can be the NMS VM in lite)

# Networks that may reach the consoles through the reverse proxy (space separated CIDRs)
LAN_CIDRS="10.0.0.0/24 172.16.0.0/21"

# ---- Docker host -----------------------------------------------------
PUID=1000                           # `id -u` of the user that owns the stack folders
PGID=1000
STACK_DIR=/opt/stacks                # where the stack folders live on each Docker host
DATA_ROOT=/srv/data                 # big disk for OpenSearch/Graylog/Grafana data (log VM)

# ---- Graylog / OpenSearch sizing --------------------------------------
OPENSEARCH_HEAP=2g                  # standard: 2g (16 GB VM) | lite: 1g
GRAYLOG_JOURNAL_MAX=1gb
SYSLOG_UDP_PORT=514                 # devices send syslog here (host 514 -> container 1514)
RETENTION_MIN_DAYS=10               # Default index set: min/max age (LRES: P10D/P14D)
RETENTION_MAX_DAYS=14

# ---- LibreNMS ---------------------------------------------------------
SNMP_COMMUNITY_HINT=use-snmp-v3     # put the real community/v3 creds into LibreNMS UI, not here
LIBRENMS_DB_NAME=librenms
LIBRENMS_DB_USER=librenms

# ---- Mail relay for alerts (msmtpd) ----------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=on
SMTP_STARTTLS=on
SMTP_AUTH=on
SMTP_USER=alerts@example.com        # password goes to secrets.env as SMTP_PASSWORD
SMTP_FROM=alerts@example.com
ALERT_TO=it@example.com

# ---- MeshCentral -----------------------------------------------------
MONGO_USERNAME=meshadmin            # password -> secrets.env

# ---- Reverse proxy / TLS ----------------------------------------------
CERT_DIR=/etc/ssl/site/wildcard.${DOMAIN}   # fullchain.pem + key.pem from acme.sh
ACME_DNS_PROVIDER=dns_desec                 # acme.sh DNS-01 hook (see stacks/reverse-proxy/ACME.md)
