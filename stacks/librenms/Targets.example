# SmokePing Targets example — copy into data/smokeping/config/Targets after first start,
# then `docker restart smokeping`. One menu per group; keep probes to what you troubleshoot.
*** Targets ***
probe = FPing
menu = Top
title = Network latency
remark = School network latency and packet loss

+ Internet
menu = Internet
title = Internet reachability

