# Overrides for the "standard" 2-VM profile (as run at LRES since 2026-10).
#   NMS VM : 4 vCPU,  6 GB RAM, 40 GB   (LibreNMS + SmokePing)
#   LOG VM : 8 vCPU, 16 GB RAM, 40 GB + 170 GB data disk (Graylog + OpenSearch + Grafana + netmon)
#   reverse proxy: small VM/CT (1 vCPU, 1 GB) or nginx on the NMS VM
OPENSEARCH_HEAP=2g
GRAYLOG_JOURNAL_MAX=1gb
