# Overrides for the single-VM "lite" profile (small schools).
# render.sh loads this AFTER site.env when PROFILE=lite.
# Recommended VM: 4 vCPU, 16 GB RAM, 40 GB system + 120 GB data disk.
OPENSEARCH_HEAP=1g
GRAYLOG_JOURNAL_MAX=512mb
RETENTION_MIN_DAYS=5
RETENTION_MAX_DAYS=7
# In lite, NMS_VM_IP, LOG_VM_IP and REVPROXY_IP must all be the same address.
